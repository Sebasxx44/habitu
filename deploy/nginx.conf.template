user www-data;
worker_processes auto;
pid /run/nginx/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log /dev/stdout;
    sendfile on;
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    server {
        listen ${PORT};
        listen [::]:${PORT};
        server_name _;
        root /var/www/public;
        index index.html;
        client_max_body_size 21M;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Cross-Origin-Opener-Policy same-origin-allow-popups always;

        location = /api { try_files /__backend_only__ @laravel; }
        location /api/ { try_files /__backend_only__ @laravel; }
        location /sanctum/ { try_files /__backend_only__ @laravel; }
        location = /docs { try_files /__backend_only__ @laravel; }
        location /docs/ { try_files /__backend_only__ @laravel; }

        location @laravel {
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /var/www/public/index.php;
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_param HTTP_PROXY "";
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_read_timeout 65s;
            fastcgi_hide_header X-Powered-By;
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options nosniff always;
        }

        location = /sw.js {
            add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
            add_header Service-Worker-Allowed / always;
        }
        location = /index.html { add_header Cache-Control "public, no-cache, must-revalidate" always; }
        location /assets/ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }
        location /storage/ {
            try_files $uri =404;
            add_header X-Content-Type-Options nosniff always;
            add_header Content-Security-Policy "sandbox" always;
        }
        location ~ /\. { deny all; }
        location ~ \.php(?:/|$) { return 404; }
        location / { try_files $uri $uri/ /index.html; }
    }
}

