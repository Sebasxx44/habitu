APP_ENV=production
APP_DEBUG=false
APP_NAME=HABITU
# Generate once: php artisan key:generate --show. Keep this key across releases.
APP_KEY=
APP_URL=https://your-backend.example.com
APP_FRONTEND_URL=https://habitu-sebaz.vercel.app
CORS_ALLOWED_ORIGINS=https://habitu-sebaz.vercel.app
# Set '*' only when the app is reachable through the provider's private ingress.
TRUSTED_PROXIES=*
# Same random secret (32+ characters) in Vercel and backend; never use a VITE_ prefix.
HABITU_PROXY_SECRET=
DATABASE_URL=
DB_CONNECTION=pgsql
DB_SSLMODE=require
CACHE_DRIVER=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
BROADCAST_DRIVER=log
REALTIME_ENABLED=false
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Use only when the provider cannot run deploy/release.sh before deployment.
RUN_MIGRATIONS_ON_START=false
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=HABITU Admin
# At least 16 characters, mixed case, numbers and symbols; never reuse demo passwords.
SUPERADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
WOMPI_ENVIRONMENT=prod
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
BOOKING_EMAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=HABITU
