APP_NAME="ElegantBarb"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (port 5433)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=elegantbarb
DB_USERNAME=elegantbarb
DB_PASSWORD=secret

# Redis
BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Mailpit for local, Postmark/Sendgrid for prod)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@elegantbarb.com"
MAIL_FROM_NAME="${APP_NAME}"

# Soketi / Pusher (WebSockets)
PUSHER_APP_ID=elegantbarb-local
PUSHER_APP_KEY=elegantbarb-key
PUSHER_APP_SECRET=elegantbarb-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=TEST-...
MERCADOPAGO_PUBLIC_KEY=TEST-...

# Wompi Colombia: never put private/integrity/event secrets in Vite.
WOMPI_ENVIRONMENT=test
# Llaves del mismo comercio/ambiente: https://docs.wompi.co/docs/colombia/ambientes-y-llaves/
# Registrar en Wompi la URL pública HTTPS: {APP_URL}/api/v2/webhooks/wompi
# APP_FRONTEND_URL debe apuntar a la app; HTTPS es obligatorio para WOMPI_ENVIRONMENT=prod.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# AWS S3 (optional, for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Naive booking dates and hours use the business timezone.
BOOKING_TIMEZONE=America/Bogota
BOOKING_REMINDER_MINUTES=1440,60
# Enable only after SMTP, queue:work and schedule:work are configured.
BOOKING_EMAIL_ENABLED=false

# Server-only interpretation. Without credentials the assistant uses explicit catalog search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GOOGLE_CLIENT_ID=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=57

# Exact HTTPS hostnames authorized for outgoing webhooks (comma-separated).
WEBHOOK_ALLOWED_HOSTS=

# OAuth Calendar requires both credentials and an exact registered callback URL.
# No simulated integration is enabled when these values are empty.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/api/v2/google-calendar/callback"

# Push FCM HTTP v1. Desactivado hasta configurar Firebase y el dominio HTTPS.
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Clave privada de cuenta de servicio; mantenerla fuera del repositorio.
FCM_PRIVATE_KEY=
FCM_SENDER_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# Wompi payout rehearsal only; production transfers remain disabled.
WOMPI_PAYOUTS_SANDBOX_ENABLED=false
WOMPI_PAYOUTS_SANDBOX_API_KEY=
WOMPI_PAYOUTS_SANDBOX_PRINCIPAL_ID=
WOMPI_PAYOUTS_SANDBOX_SOURCE_ACCOUNT_ID=
WOMPI_PAYOUTS_SANDBOX_BANK_ID=
